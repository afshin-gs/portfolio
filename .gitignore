legacy/

# build output
dist/
# latexmk aux files. The compiled PDF itself IS committed: CI has no Docker
# step, so the deployed PDF has to come from the repo. public/cv.pdf is then
# DERIVED from it at build time by cv/publish.sh, so it is not tracked.
cv/output/*
!cv/output/.gitkeep
!cv/output/cv.pdf
public/cv.pdf
