# docs/architecture.md §14 — unified-origin local development (D9).
#
# One HTTPS origin, https://iamafshin.localhost, in front of every dev server,
# so the site and the apps share localStorage (theme sync, §12) and see the
# same paths as production. Started by `bun run dev:all`, which also starts
# the app dev servers and generates their routes. Plain `bun dev` needs none
# of this.
#
# Routing mirrors production: each app owns /apps/<slug>*, the website gets
# everything else. Caddy orders `handle` blocks by path specificity, so the
# catch-all below always loses to an app.
{
	# Nothing here needs a live config API, and leaving it on would collide
	# with any other Caddy running on this machine (:2019).
	admin off

	# Startup chatter would drown out Astro's output in the shared terminal.
	log {
		level WARN
	}
}

iamafshin.localhost {
	# ── Apps ─────────────────────────────────────────────────────────────────
	# Generated by scripts/dev-all.sh from src/data/apps.json and
	# src/data/bundled-apps.json: one block per app with a sibling checkout,
	#
	#   handle /apps/<slug>* {
	#   	reverse_proxy localhost:<port>
	#   }
	#
	#   - The same greedy pattern as production (D10). /apps/<slug>/* would
	#     miss the bare /apps/<slug>.
	#   - `handle`, never `handle_path`: stripping the prefix would make dev
	#     paths differ from production. The app's dev server runs with base
	#     /apps/<slug>/ instead.
	#
	# Empty when started without the script, so every path goes to Astro.
	import .caddy/*.caddy

	# ── Website ──────────────────────────────────────────────────────────────
	handle {
		reverse_proxy localhost:4321
	}

	# A dev server that is not running is a 502. Say so, instead of Caddy's
	# blank page.
	handle_errors 502 {
		respond "No dev server is running for {http.request.uri.path}. `bun run dev:all` starts every app that has a checkout next to this repository." 502
	}
}
