---
import type { TimelineEntry } from '../../data/resume'

/**
 * Vertical timeline for resume-shaped data.
 *
 * Data-driven rather than a Timeline/TimelineItem pair: every caller renders
 * the same four fields from the same typed shape, so a slot-based API would
 * only offer the freedom to render it inconsistently. If an entry ever needs
 * genuinely custom content, add an optional slot then — not before.
 *
 * The rail and the nodes are drawn with pseudo-elements so the DOM stays a
 * plain <ol> of entries: correct reading order, and nothing decorative for a
 * screen reader to announce.
 */
interface Props {
  entries: readonly TimelineEntry[]
  class?: string
}

const { entries, class: className } = Astro.props
---

<ol class:list={['timeline', className]}>
  {
    entries.map((entry) => (
      <li class="entry">
        {/* Optional: a project with no date on record shows no period label
            rather than an invented one. */}
        {entry.period && <p class="period">{entry.period}</p>}
        <h4 class="title">{entry.title}</h4>
        {entry.org && <p class="org">{entry.org}</p>}
        {entry.detail && <p class="detail">{entry.detail}</p>}
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--space-5);
  }

  /* The rail. Fades out at the bottom so it reads as "continues" rather than
   * as a line that stops for no reason. */
  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55rem;
    bottom: 0;
    width: 1px;
    background: linear-gradient(
      180deg,
      var(--accent-line),
      color-mix(in srgb, var(--border) 100%, transparent) 65%,
      transparent
    );
  }

  .entry {
    position: relative;
    padding-bottom: var(--space-6);
  }
  .entry:last-child {
    padding-bottom: 0;
  }

  /* The node. Filled centre on a --bg ring so the rail visually passes behind. */
  .entry::before {
    content: '';
    position: absolute;
    left: calc(var(--space-5) * -1 - 3.5px);
    top: 0.5rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--bg);
  }

  .period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--accent);
    margin-bottom: var(--space-1);
  }

  .title {
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
  }

  .org {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
    margin-top: var(--space-1);
  }

  .detail {
    margin-top: var(--space-2);
    font-size: var(--text-base);
    color: var(--muted);
    max-width: 58ch;
  }
</style>
