---
import PageLayout from '../layouts/PageLayout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import Timeline from '../components/ui/Timeline.astro'
import { resumeSections } from '../data/resume'
import { site } from '../data/site'

/**
 * The web summary of the resume. The authoritative document is now cv/main.tex,
 * typeset with LaTeX and served at /cv.pdf, so this page is deliberately the
 * shorter of the two: no per-course grades, no bullet list per project.
 *
 * The print rules at the bottom stay. Someone will still hit Ctrl+P on this
 * page, and it should not print a screenful of dark-mode ink or split entries
 * awkwardly across a page break.
 */
---

<PageLayout title="Resume" description={`Resume of ${site.name}.`}>
  <PageHeader
    title="Resume"
    lede="A summary. The full two-page CV, with coursework and grades, is a typeset PDF."
  />

  <p class="download">
    <a href="/cv.pdf">Download the full CV (PDF)</a>
    <span class="note">2 pages, A4</span>
  </p>

  <div class="columns">
    {
      resumeSections.map((section) => (
        <section id={section.id}>
          <h2>{section.heading}</h2>
          <Timeline entries={section.entries} />
        </section>
      ))
    }
  </div>
</PageLayout>

<style>
  .download {
    font-size: var(--text-sm);
    padding-bottom: var(--space-6);
  }
  .download .note {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    margin-left: var(--space-2);
  }

  .columns {
    display: grid;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
  }
  @media (min-width: 56rem) {
    .columns {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-9);
      align-items: start;
    }
  }

  h2 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--accent);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--border);
  }

  /* Printing. The theme is a screen concern: force light so a dark-mode reader
   * does not print a page of solid ink, and drop the columns so entries are
   * not split awkwardly across a page break. */
  @media print {
    /* A download link on paper is dead ink. */
    .download {
      display: none;
    }
    .columns {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    section {
      break-inside: avoid;
    }
  }
</style>

<style is:global>
  @media print {
    :root,
    :root[data-theme='dark'] {
      --bg: #ffffff;
      --bg-elevated: #ffffff;
      --fg: #000000;
      --muted: #444444;
      --border: #cccccc;
      --surface: #ffffff;
      --accent: #000000;
      --surface-raised: #ffffff;
      --surface-hover: #ffffff;
    }

    /* Chrome is navigation; paper has none. */
    .site-header,
    .site-footer,
    .skip-link {
      display: none !important;
    }

    body {
      background: #ffffff;
    }
  }
</style>
