---
import PageLayout from '../layouts/PageLayout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import SectionHeading from '../components/ui/SectionHeading.astro'
import Button from '../components/ui/Button.astro'
import SocialIcon from '../components/ui/SocialIcon.astro'
import { contactPrompt, cvFile } from '../data/profile'
import { site } from '../data/site'

/**
 * The destination for every "Get in touch" on the site.
 *
 * NO CONTACT FORM, deliberately. A form needs somewhere to POST, and this is a
 * static site on Cloudflare Workers assets with no server and no runtime
 * compute (docs §16). The options would be a third-party form service, which
 * means routing a stranger's message and whatever they put in it through
 * someone else's database, or a `mailto:` form that opens the same mail client
 * the address below opens anyway. So: the address, plainly, and the profiles
 * that carry a message channel of their own.
 *
 * Socials still set to '#' in site.ts are dropped here exactly as they are in
 * the footer. A dead link is worse than an absent one.
 */
const socials = site.socials.filter((social) => social.href !== '#')
---

<PageLayout
  title="Contact"
  description={`Get in touch with ${site.name}: email and profiles, no form.`}
>
  <PageHeader title="Get in touch" lede={contactPrompt.body} />

  <div class="layout">
    <div class="main">
      <section aria-labelledby="email">
        <SectionHeading id="email">Email</SectionHeading>

        <a class="email" href={`mailto:${site.email}`}>
          <span class="prompt" aria-hidden="true">&gt;</span>
          <span class="address">{site.email}</span>
        </a>

        <p class="note">
          The fastest way to reach me. I read everything, and I reply to anything
          that is not a mailing list.
        </p>
      </section>

      {
        socials.length > 0 && (
          <section aria-labelledby="elsewhere">
            <SectionHeading id="elsewhere">Elsewhere</SectionHeading>
            <ul class="socials">
              {socials.map((social) => (
                <li>
                  <a href={social.href} target="_blank" rel="me noopener noreferrer">
                    <SocialIcon name={social.label} class="social-mark" />
                    <span class="social-label">{social.label}</span>
                    <span class="sr-only"> (opens in a new tab)</span>
                    <span class="arrow" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <aside class="side">
      <h2 class="side-title">Based in</h2>
      <p class="side-note">
        {site.location}<br />
        Department of Chemical Engineering,<br />
        Shiraz University
      </p>

      <h2 class="side-title">Curriculum vitae</h2>
      <p class="side-note">The full record, as a single document.</p>
      <div class="cv-actions">
        <Button href="/resume" size="sm" variant="secondary" icon="→">Read the summary</Button>
        <Button href={cvFile.href} size="sm" variant="ghost" icon="↓" download>PDF</Button>
      </div>
    </aside>
  </div>
</PageLayout>

<style>
  .layout {
    display: grid;
    gap: var(--space-8);
    padding-bottom: var(--space-9);
  }
  @media (min-width: 56rem) {
    .layout {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-9);
      align-items: start;
    }
  }

  .main {
    display: grid;
    gap: var(--space-8);
    min-width: 0;
  }

  .email {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-lg);
    background: var(--accent-soft);
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: var(--fg);
    text-decoration: none;
    /* The address must never force the page into a horizontal scroll. */
    max-width: 100%;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .email:hover {
    border-color: var(--accent);
  }
  .prompt {
    flex: none;
    color: var(--accent);
  }
  .address {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .note {
    margin-top: var(--space-4);
    font-size: var(--text-base);
    color: var(--muted);
    max-width: 56ch;
  }

  .socials {
    list-style: none;
    display: grid;
    gap: var(--space-1);
  }
  .socials a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    color: var(--fg);
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .socials a:hover {
    border-color: var(--accent-line);
    background: var(--surface-hover);
  }
  /* Pushes the arrow to the far edge while the mark stays beside the label. */
  .social-label {
    flex: 1;
    min-width: 0;
    font-size: var(--text-base);
    font-weight: 500;
  }
  .socials :global(.social-mark) {
    font-size: 1.15rem;
    color: var(--accent);
  }
  .arrow {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
  }

  .side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  /* Matches the About sidebar: the SectionHeading language one step down in
   * size, so an aside never competes with the column beside it. */
  .side-title {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--accent);
    border-bottom: 1px solid var(--border);
    align-self: stretch;

    /*
     * The rule under this heading has to land on the rule under the main
     * column's first SectionHeading: both columns start at the same y (the
     * grid is `align-items: start`), so two headings of different sizes put
     * two hairlines 13px apart, which reads as a mistake rather than as a
     * hierarchy.
     *
     * Matching SectionHeading's box instead of measuring the gap: its line box
     * is --text-xl at --leading-tight (base.css sets that for h1–h3) and its
     * padding-bottom is --space-3. Reproduce both and the hairlines coincide
     * at every viewport width, which matters because --text-xl is a clamp()
     * and any fixed offset would only be right at one size.
     *
     * flex-end keeps the text sitting just above the rule, the way it does in
     * SectionHeading, rather than floating at the top of the taller box.
     *
     * The padding and the hairline are IN the min-height because box-sizing is
     * border-box: without them the box only reaches 30.6px against the other
     * column's 39.4px, which looks like the fix worked and leaves the rules
     * 9px apart.
     */
    display: flex;
    align-items: flex-end;
    min-height: calc(var(--text-xl) * var(--leading-tight) + var(--space-3) + 1px);
    padding-bottom: var(--space-3);
  }
  .side-title + :global(*) {
    margin-top: 0;
  }
  .side-title:not(:first-child) {
    margin-top: var(--space-5);
  }

  .side-note {
    color: var(--muted);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
