---
import { render } from 'astro:content'
import Post from '../../layouts/Post.astro'
import { mdxComponents } from '../../components/mdx'
import { getItems } from '../../lib/content'

// includeInactive: retired posts must still build their route so previously
// shared links never 404 (§7).
export async function getStaticPaths() {
  const items = await getItems('blog', { includeInactive: true })
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }))
}

const { item } = Astro.props
const { Content } = await render(item.entry)
const { data } = item.entry
---

<Post
  title={data.title}
  excerpt={data.excerpt}
  date={data.date}
  updated={data.updated}
  tags={data.tags}
  derived={item}
  collection="blog"
  banner={data.banner}
  bannerAlt={data.bannerAlt}
>
  {/* §8 — the override map. Posts need no import statements. */}
  <Content components={mdxComponents} />
</Post>
