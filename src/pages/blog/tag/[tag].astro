---
import PageLayout from '../../../layouts/PageLayout.astro'
import PageHeader from '../../../components/ui/PageHeader.astro'
import EntryList from '../../../components/EntryList.astro'
import { getItems, getTags } from '../../../lib/content'

// §10 — prerendered facets. Crawlable and linkable; the island handles the
// combinatorial cases (multi-tag, date ranges, text) that are not worth prerendering.
export async function getStaticPaths() {
  const tags = await getTags('blog')
  const items = await getItems('blog')
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag, items: items.filter((i) => i.entry.data.tags.includes(tag)) },
  }))
}

const { tag, items } = Astro.props
---

<PageLayout title={`Blog tagged “${tag}”`} description={`Blog posts tagged ${tag}.`}>
  <PageHeader
    title={`Tagged “${tag}”`}
    back={{ label: 'Blog', href: '/blog' }}
  />
  <EntryList items={items} collection="blog" />
  <div class="tail"></div>
</PageLayout>

<style>
  .tail {
    padding-bottom: var(--space-8);
  }
</style>
