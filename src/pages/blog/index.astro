---
import PageLayout from '../../layouts/PageLayout.astro'
import PageHeader from '../../components/ui/PageHeader.astro'
import FilterBar from '../../components/filter/FilterBar.astro'
import EntryList from '../../components/EntryList.astro'
import { getItems, getTags } from '../../lib/content'

// Prerendered with ALL entries present. The filter island (§10) is progressive
// enhancement over this — with JS off the page is complete and fully usable.
const items = await getItems('blog')
const tags = await getTags('blog')
---

<PageLayout title="Blog" description="Blog Posts by Afshin Ghorbani.">
  <PageHeader title="Blog" />
  {/* Only when there is something to filter — the bar is no longer
      hidden until mount, so an empty list would render dead controls. */}
  {items.length > 0 && <FilterBar collection="blog" tags={tags} label="Search posts" />}
  <EntryList items={items} collection="blog" empty="No posts published yet." />
  <div class="tail"></div>
</PageLayout>

<style>
  .tail {
    padding-bottom: var(--space-8);
  }
</style>
