---
import '../styles/fonts.css'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/prose.css'
import '../styles/lightbox.css'
import 'katex/dist/katex.min.css'
import { THEME_KEY, THEME_DEFAULT } from '../lib/theme'
import { pageTitle, site } from '../data/site'
import { buildSocialMeta, type SocialType } from '../lib/seo'

/**
 * The document shell: <head>, the theme bootstrap, and nothing else.
 *
 * Deliberately WITHOUT site chrome. PageLayout adds the header and footer for
 * ordinary pages; AppShell gives an embedded app its own minimal chrome. A
 * layout that always injected a nav would leave app pages no way to opt out.
 */
interface Props {
  /** Page title WITHOUT the site suffix — pageTitle() appends it. */
  title?: string
  description?: string
  /** Set false on pages that should not be indexed. */
  indexable?: boolean

  /* --- Social preview (src/lib/seo.ts). Every page gets a card; these only
     override the site-wide defaults. --- */

  /** `article` on a post or project detail page, `website` everywhere else. */
  ogType?: SocialType
  /** A collection `banner`, or a path inside `public/` already sized 1200×630. */
  image?: ImageMetadata | string
  imageAlt?: string
  /** `article` only — becomes `article:published_time`. */
  date?: Date
  updated?: Date
  tags?: readonly string[]
}

const {
  title,
  description = site.description,
  indexable = true,
  ogType,
  image,
  imageAlt,
  date,
  updated,
  tags,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site).href
const resolvedTitle = pageTitle(title)

// Astro.site is set in astro.config.mjs and is what makes every social URL
// absolute. Without it a scraper gets root-relative paths it cannot resolve.
const social = await buildSocialMeta(
  {
    title: resolvedTitle,
    description,
    canonical,
    type: ogType,
    image,
    imageAlt,
    date,
    updated,
    tags,
  },
  new URL(Astro.site!),
)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!indexable && <meta name="robots" content="noindex" />}

    {/*
      Matches --bg so the browser UI does not fight the page. Deliberately NOT
      two tags keyed on prefers-color-scheme: with `system` removed the OS
      preference no longer decides anything, so an OS-keyed theme-color would
      tint the browser chrome dark while the page rendered light. initTheme()
      rewrites this from the resolved --bg.
    */}
    <meta name="theme-color" content="#fbfbfd" />

    {/*
      Social preview. src/lib/seo.ts explains WHY each of these is here and
      what breaks on which platform without it — read that before trimming any
      of them as redundant. In short:

        Telegram / WhatsApp / Slack / Discord / LinkedIn — Open Graph only.
        Facebook — Open Graph; needs og:image:width/height on the first scrape.
        X — falls back to Open Graph, but only shows a big card with
            twitter:card=summary_large_image.
    */}
    <meta property="og:type" content={social.type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={social.title} />
    <meta property="og:description" content={social.description} />
    <meta property="og:url" content={social.canonical} />

    <meta property="og:image" content={social.image.url} />
    {/* WhatsApp in particular prefers the explicitly-secure variant. */}
    <meta property="og:image:secure_url" content={social.image.url} />
    <meta property="og:image:type" content={social.image.type} />
    <meta property="og:image:width" content={String(social.image.width)} />
    <meta property="og:image:height" content={String(social.image.height)} />
    <meta property="og:image:alt" content={social.image.alt} />

    {
      social.type === 'article' && (
        <>
          {social.publishedTime && (
            <meta property="article:published_time" content={social.publishedTime} />
          )}
          {social.modifiedTime && (
            <meta property="article:modified_time" content={social.modifiedTime} />
          )}
          <meta property="article:author" content={site.name} />
          {social.tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    {/* summary_large_image, not summary: `summary` renders a small square
        thumbnail that crops a 1200×630 banner to its middle third. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={social.title} />
    <meta name="twitter:description" content={social.description} />
    <meta name="twitter:image" content={social.image.url} />
    <meta name="twitter:image:alt" content={social.image.alt} />
    {site.twitter && <meta name="twitter:creator" content={site.twitter} />}
    {site.twitter && <meta name="twitter:site" content={site.twitter} />}

    <meta name="author" content={site.name} />

    {/*
      Preload only the `latin` subsets — the ones every page needs. latin-ext
      is left to the normal unicode-range fetch, which most pages never trigger.
      crossorigin is REQUIRED even same-origin: fonts are fetched in CORS mode,
      and without it the browser downloads the file twice.
    */}
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/*
      docs/architecture.md §12 — MUST be inline and synchronous, before any
      stylesheet. A deferred or module script runs after first paint and flashes
      white on every navigation for dark-mode readers. This is the single most
      commonly botched part of the contract; do not "clean it up" into a module.
    */}
    <script is:inline define:vars={{ THEME_KEY, THEME_DEFAULT }}>
      ;(function () {
        try {
          // Anything other than the two valid values — including a 'system'
          // left over from before that mode was removed — falls back to the
          // default rather than painting an unknown theme.
          var s = localStorage.getItem(THEME_KEY)
          var t = s === 'dark' || s === 'light' ? s : THEME_DEFAULT
          document.documentElement.dataset.theme = t
          document.documentElement.style.colorScheme = t
        } catch (e) {}

        // Marks that scripting is available, synchronously and before first
        // paint. CSS uses it to reveal script-dependent controls (the filter
        // bar) with no flash and no layout shift — an element revealed later
        // by its own module would shove the page down after it had rendered.
        document.documentElement.classList.add('js')
      })()
    </script>
  </head>

  <body>
    <slot />

    <script>
      import { initTheme } from '../lib/theme'
      initTheme()
    </script>
  </body>
</html>
