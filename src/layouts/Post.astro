---
import PageLayout from './PageLayout.astro'
import Tag from '../components/ui/Tag.astro'
import type { Derived } from '../lib/content'

/**
 * Detail page for a blog post or a project. D5 — one layout, parameterised by
 * collection, so the two cannot drift apart in behaviour.
 *
 * `width="article"` gives the write-up its own measure without each page
 * setting its own max-width. Anything wider than the column (a table, a wide
 * chart, a code block) is handled by the MDX override components, which scroll
 * inside their own box rather than widening the page.
 */
interface Props {
  title: string
  excerpt: string
  date: Date
  updated?: Date
  tags: string[]
  derived: Derived
  collection: 'blog' | 'projects'
  /** The entry's `banner`. Absent → the site-wide default card is shared. */
  banner?: ImageMetadata
  bannerAlt?: string
}

const {
  title,
  excerpt,
  date,
  updated,
  tags,
  derived,
  collection,
  banner,
  bannerAlt,
} = Astro.props

// timeZone: 'UTC' — frontmatter dates are date-only and coerce to midnight UTC,
// so formatting them locally shows the previous day west of Greenwich.
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  })

const BACK: Record<Props['collection'], string> = {
  blog: 'Blog',
  projects: 'Projects',
}
---

{/*
  ogType="article" is what turns a shared link into a dated, attributed card
  rather than an anonymous site link. The banner doubles as the preview image,
  so a post never needs a second image authored just for sharing.
*/}
<PageLayout
  title={title}
  description={excerpt}
  width="article"
  ogType="article"
  image={banner}
  imageAlt={bannerAlt}
  date={date}
  updated={updated}
  tags={tags}
>
  <article class="post">
    <header>
      <p class="back">
        <a href={`/${collection}`}>
          <span aria-hidden="true">←</span> {BACK[collection]}
        </a>
      </p>

      <h1>{title}</h1>

      <p class="meta">
        <time datetime={date.toISOString()}>{fmt(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{derived.readingTime} min read</span>
        {
          updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>updated {fmt(updated)}</span>
            </>
          )
        }
      </p>

      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>
                <Tag href={`/${collection}/tag/${tag}`}>{tag}</Tag>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {/* Styled by src/styles/prose.css — see the note at the top of that file. */}
    <div class="prose"><slot /></div>
  </article>
</PageLayout>

<style>
  .post {
    padding-block: var(--space-7) var(--space-9);
  }

  header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-7);
    border-bottom: 1px solid var(--border);
  }

  .back {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .back a {
    color: var(--muted);
    text-decoration: none;
  }
  .back a:hover {
    color: var(--accent);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }
</style>
